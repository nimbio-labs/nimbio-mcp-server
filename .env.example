# Copy to .env and load it however you like (dotenv, direnv, your shell).

# Required. A nimbio_test_* key simulates side effects; a nimbio_live_* key
# performs them. test-vs-live is the KEY, not a separate flag.
NIMBIO_API_KEY=nimbio_test_your_key_here

# Which deployment to talk to: prod (default), dev, or local.
# NIMBIO_ENV=prod

# read-only (default) | write | unrestricted
# NIMBIO_MCP_MODE=read-only

# Required before a live (non-test) key may register write tools.
# NIMBIO_MCP_ALLOW_LIVE=1

# Register every tool regardless of what the key's capabilities allow.
# NIMBIO_MCP_ALL_TOOLS=1
